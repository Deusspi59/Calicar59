<!DOCTYPE html>

<html lang="fr"> <head> <meta charset="UTF-8"> <meta name="viewport" content="width=device-width, initial-scale=1.0">

<meta name="description" content="Calicar59 à Attiches dans le Nord (59) : achat et vente de véhicules d'occasion. Découvrez nos véhicules disponibles.">
<meta name="keywords" content="Calicar59, véhicules occasion, voiture occasion, achat voiture, vente voiture, Attiches, Nord 59">
<meta name="author" content="Calicar59">

<title>Calicar59 | Achat & Vente de véhicules d'occasion</title>

<link rel="stylesheet" href="style.css">

</head>

<body>

<!-- ================= HEADER ================= -->
<header class="header">

    <div class="container header-content">

        <a href="#" class="logo">
            <span class="logo-main">CALICAR</span><span class="logo-number">59</span>
        </a>

        <nav class="navigation">
            <a href="#accueil">Accueil</a>
            <a href="#vehicules">Nos véhicules</a>
            <a href="#services">Nos services</a>
            <a href="#a-propos">À propos</a>
            <a href="#contact" class="nav-contact">Contact</a>
        </nav>

    </div>

</header>


<!-- ================= HERO ================= -->
<main>

    <section id="accueil" class="hero">

        <div class="container hero-content">

            <div class="hero-text">

                <p class="hero-subtitle">
                    CALICAR59 · ATTICHES · NORD (59)
                </p>

                <h1>
                    Votre prochaine voiture
                    <span>vous attend ici.</span>
                </h1>

                <p class="hero-description">
                    Calicar59 vous accompagne dans l'achat et la vente
                    de véhicules d'occasion dans le Nord.
                </p>

                <div class="hero-buttons">
                    <a href="#vehicules" class="btn btn-primary">
                        Voir nos véhicules
                    </a>

                    <a href="#contact" class="btn btn-secondary">
                        Nous contacter
                    </a>
                </div>

            </div>

            <div class="hero-car">
                <div class="car-placeholder">
                    🚘
                </div>
            </div>

        </div>

    </section>


    <!-- ================= VEHICULES ================= -->
    <section id="vehicules" class="vehicles-section">

        <div class="container">

            <div class="section-title">

                <p class="section-subtitle">
                    NOTRE STOCK
                </p>

                <h2>
                    Nos véhicules d'occasion
                </h2>

                <p>
                    Découvrez prochainement notre sélection de véhicules
                    disponibles à la vente.
                </p>

            </div>


            <div class="vehicles-grid">

                <!-- VEHICULE 1 -->
                <article class="vehicle-card">

                    <div class="vehicle-image">
                        <span class="vehicle-label">À vendre</span>
                        <div class="image-placeholder">
                            🚗
                        </div>
                    </div>

                    <div class="vehicle-content">

                        <p class="vehicle-category">
                            CITADINE
                        </p>

                        <h3>
                            Véhicule à découvrir
                        </h3>

                        <p class="vehicle-info">
                            Essence · Manuelle · 5 portes
                        </p>

                        <div class="vehicle-bottom">

                            <strong>
                                Prix à venir
                            </strong>

                            <a href="#contact" class="vehicle-link">
                                En savoir plus →
                            </a>

                        </div>

                    </div>

                </article>


                <!-- VEHICULE 2 -->
                <article class="vehicle-card">

                    <div class="vehicle-image">
                        <span class="vehicle-label">À vendre</span>
                        <div class="image-placeholder">
                            🚙
                        </div>
                    </div>

                    <div class="vehicle-content">

                        <p class="vehicle-category">
                            SUV
                        </p>

                        <h3>
                            Véhicule à découvrir
                        </h3>

                        <p class="vehicle-info">
                            Diesel · Automatique · 5 portes
                        </p>

                        <div class="vehicle-bottom">

                            <strong>
                                Prix à venir
                            </strong>

                            <a href="#contact" class="vehicle-link">
                                En savoir plus →
                            </a>

                        </div>

                    </div>

                </article>


                <!-- VEHICULE 3 -->
                <article class="vehicle-card">

                    <div class="vehicle-image">
                        <span class="vehicle-label">À vendre</span>
                        <div class="image-placeholder">
                            🚘
                        </div>
                    </div>

                    <div class="vehicle-content">

                        <p class="vehicle-category">
                            BERLINE
                        </p>

                        <h3>
                            Véhicule à découvrir
                        </h3>

                        <p class="vehicle-info">
                            Essence · Automatique · 5 portes
                        </p>

                        <div class="vehicle-bottom">

                            <strong>
                                Prix à venir
                            </strong>

                            <a href="#contact" class="vehicle-link">
                                En savoir plus →
                            </a>

                        </div>

                    </div>

                </article>

            </div>

        </div>

    </section>


    <!-- ================= SERVICES ================= -->
    <section id="services" class="services-section">

        <div class="container">

            <div class="section-title">

                <p class="section-subtitle">
                    NOS SERVICES
                </p>

                <h2>
                    Calicar59, votre partenaire automobile
                </h2>

            </div>


            <div class="services-grid">

                <div class="service-card">

                    <div class="service-icon">
                        🚗
                    </div>

                    <h3>
                        Vente de véhicules
                    </h3>

                    <p>
                        Retrouvez une sélection de véhicules d'occasion
                        soigneusement proposés à la vente.
                    </p>

                </div>


                <div class="service-card">

                    <div class="service-icon">
                        💰
                    </div>

                    <h3>
                        Achat de véhicules
                    </h3>

                    <p>
                        Vous souhaitez vendre votre véhicule ?
                        Contactez Calicar59 pour échanger sur votre voiture.
                    </p>

                </div>


                <div class="service-card">

                    <div class="service-icon">
                        🤝
                    </div>

                    <h3>
                        Un accompagnement personnalisé
                    </h3>

                    <p>
                        Notre objectif : vous accompagner avec sérieux
                        dans votre projet automobile.
                    </p>

                </div>

            </div>

        </div>

    </section>


    <!-- ================= A PROPOS ================= -->
    <section id="a-propos" class="about-section">

        <div class="container about-content">

            <div class="about-box">

                <p class="section-subtitle">
                    QUI SOMMES-NOUS ?
                </p>

                <h2>
                    Bienvenue chez Calicar59
                </h2>

                <p>
                    Installé à <strong>Attiches dans le Nord (59)</strong>,
                    Calicar59 est spécialisé dans l'achat et la vente
                    de véhicules d'occasion.
                </p>

                <p>
                    Nous souhaitons proposer une expérience simple,
                    transparente et agréable pour accompagner nos clients
                    dans leur projet automobile.
                </p>

                <a href="#contact" class="btn btn-primary">
                    Parlons de votre projet
                </a>

            </div>

        </div>

    </section>


    <!-- ================= CONTACT ================= -->
    <section id="contact" class="contact-section">

        <div class="container contact-content">

            <div class="contact-text">

                <p class="section-subtitle">
                    CONTACT
                </p>

                <h2>
                    Vous avez un projet automobile ?
                </h2>

                <p>
                    Une question sur un véhicule ? Vous souhaitez vendre
                    votre voiture ? Contactez-nous.
                </p>

            </div>


            <div class="contact-card">

                <div class="contact-item">
                    <span>📍</span>

                    <div>
                        <strong>Adresse</strong>
                        <p>Attiches, Nord (59)</p>
                    </div>
                </div>


                <div class="contact-item">
                    <span>📞</span>

                    <div>
                        <strong>Téléphone</strong>
                        <p>
                            <a href="tel:+33000000000">
                                00 00 00 00 00
                            </a>
                        </p>
                    </div>
                </div>


                <div class="contact-item">
                    <span>✉️</span>

                    <div>
                        <strong>Email</strong>
                        <p>
                            <a href="mailto:contact@calicar59.fr">
                                contact@calicar59.fr
                            </a>
                        </p>
                    </div>
                </div>

            </div>

        </div>

    </section>

</main>


<!-- ================= FOOTER ================= -->
<footer class="footer">

    <div class="container footer-content">

        <div>
            <a href="#" class="logo footer-logo">
                <span class="logo-main">CALICAR</span><span class="logo-number">59</span>
            </a>

            <p>
                Achat & vente de véhicules d'occasion
            </p>
        </div>


        <div class="footer-links">

            <a href="#accueil">Accueil</a>
            <a href="#vehicules">Véhicules</a>
            <a href="#services">Services</a>
            <a href="#contact">Contact</a>

        </div>

    </div>


    <div class="footer-bottom">

        <p>
            © 2026 Calicar59 — Tous droits réservés.
        </p>

    </div>

</footer>

</body> </html>
